# ─────────────────────────────────────────────────────────────────────────────
# High-Performance Autonomous Browser Harness — Environment Configuration Template
# ─────────────────────────────────────────────────────────────────────────────

# [REQUIRED] Groq Cloud API Key
# Sign up and generate a key at: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# [OPTIONAL] Groq Model ID (e.g. openai/gpt-oss-120b, llama-3.3-70b-versatile, qwen/qwen3.8-27b)
GROQ_MODEL=openai/gpt-oss-120b

# [OPTIONAL] Master Secret for Authenticated Session Encryption Vault
HARNESS_VAULT_KEY=

# [OPTIONAL] Chromium Execution Mode (true for headless, false for headed debug window)
HARNESS_HEADLESS=true

# [OPTIONAL] CDP Stealth Profile (ultra | fast)
HARNESS_STEALTH=ultra

# [OPTIONAL] Maximum Concurrency for Fast-Path Recursive HTTP/2 Crawler
HARNESS_CRAWLER_CONCURRENCY=8

# [OPTIONAL] High-Throughput SQLite WAL Datastore Path
HARNESS_DB_PATH=.harness/harvest.db
